# Environment variables for ppt_slidemaker
# Copy this file to .env and fill in your actual values

# OpenRouter API (for AI model)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Neon PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?options
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-id.aws.neon.tech/neondb?sslmode=require

# AWS S3 Access Point
# Get these from your AWS S3 Access Point configuration
AWS_S3_ACCESS_POINT_ARN=arn:aws:s3:us-east-1:YOUR_ACCOUNT_ID:accesspoint/YOUR_ACCESS_POINT_NAME
AWS_S3_ACCESS_POINT_ALIAS=YOUR_ACCESS_POINT_ALIAS-s3alias
AWS_REGION=us-east-1

# Server configuration
PORT=3000